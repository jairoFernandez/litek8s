# Copy this file to terraform.tfvars and edit for your account:
#
#   cp terraform.tfvars.example terraform.tfvars
#
# terraform.tfvars is gitignored so your account-specific values stay local.

# AWS CLI profile that Terraform (and the AWS provider) should use.
profile = "default"

# Region to provision the litek8s nodes in.
region = "us-east-1"

# Name prefix applied to every AWS resource for identification/cleanup.
project_prefix = "{{PROJECT_NAME}}"

# Nodes to provision. Each entry becomes an EC2 instance; `name` is the logical
# node name you later pass to `litek8s node add <name>`. `arch` is x86_64 or
# arm64 (arm64 picks a Graviton AMI). `disk_gb` sizes the root volume.
hetero_nodes = [
  { name = "node-0", type = "t3.small", arch = "x86_64", disk_gb = 12 },
  # Add more nodes as needed, for example:
  # { name = "node-1", type = "c6g.large", arch = "arm64", disk_gb = 20 },
]

# Path to the SSH public key registered on the nodes. The matching private key
# (defaults to ~/.ssh/id_ed25519 in deploy.sh) is used by `litek8s node add`.
# public_key_path = "~/.ssh/id_ed25519.pub"

# Restrict SSH ingress. Empty string auto-detects your current public IP as /32.
# ssh_ingress_cidr = ""
