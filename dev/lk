#!/usr/bin/env bash
# litek8s from this checkout, kept apart from an installed litek8s (Homebrew,
# install.sh): its own LITEK8S_HOME, so its own dev VM, clusters, Docker
# sockets, config.yaml, kubeconfig and contexts. See docs/develop-without-docker.md.
#
#   dev/lk <litek8s args>      run this checkout's target/release/litek8s, rebuilt
#                              first when a source is newer (CARGO_BUILD_JOBS=4)
#   dev/lk env                 eval "$(dev/lk env)": DOCKER_HOST and KUBECONFIG
#   dev/lk build-vm            the dev VM's guest from this checkout, into
#                              $LITEK8S_HOME/data/vm (needs a Docker API, see below)
#   dev/lk paths               where everything is
#   dev/lk stable <cmd>        the pinned litek8s (dev/stable.sh): install [rev],
#                              up [args], down, status, reset, env
#
# LITEK8S_HOME defaults to ~/.litek8s-dev; its kubeconfig contexts are
# lkdev-<cluster> (LITEK8S_CONTEXT_PREFIX) in $LITEK8S_HOME/kubeconfig.
# build-vm compiles the guest in a rust:alpine container on this home's own
# Docker API when its VM runs, else on DOCKER_HOST / the docker context.
# First guest on a machine: boot the installed release's guest once,
#   LITEK8S_DEV_VM_ASSETS="$(brew --prefix)/share/litek8s/vm" dev/lk dev up
#   dev/lk build-vm && dev/lk dev down && dev/lk dev up
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-4}"

usage() { sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 2; }

# The profile: LITEK8S_HOME and the binary that runs in it.
profile() {
  HOME_DIR="$1" BIN="$2"
  export LITEK8S_HOME="$HOME_DIR"
  SOCK="$HOME_DIR/docker.sock"
  KCFG="$HOME_DIR/kubeconfig"
}

lk_env() {
  echo "export DOCKER_HOST=unix://$SOCK"
  echo "export KUBECONFIG=$KCFG"
  echo "# contexts: ${LITEK8S_CONTEXT_PREFIX:-lkdev-}<cluster>; litek8s for this home: LITEK8S_HOME=$HOME_DIR $BIN"
}

# ---- this checkout ------------------------------------------------------

TARGET="${CARGO_TARGET_DIR:-$ROOT/target}"
checkout() { profile "${LITEK8S_HOME:-$HOME/.litek8s-dev}" "$TARGET/release/litek8s"; }

# Rebuild when the binary is missing or older than anything it is built from.
ensure_built() {
  if [[ -x "$BIN" ]] && [[ -z "$(cd "$ROOT" && find src proto openapi build.rs Cargo.toml Cargo.lock -newer "$BIN" -print -quit 2>/dev/null)" ]]; then
    return
  fi
  echo "dev/lk: building $(git -C "$ROOT" rev-parse --short=12 HEAD 2>/dev/null) (release, $CARGO_BUILD_JOBS jobs)" >&2
  (cd "$ROOT" && cargo build --release --quiet)
}

build_vm() {
  local out="$HOME_DIR/data/vm"
  if [[ -S "$SOCK" ]] && DOCKER_HOST="unix://$SOCK" docker version >/dev/null 2>&1; then
    export DOCKER_HOST="unix://$SOCK"
  fi
  echo "dev/lk: building the dev VM's guest on ${DOCKER_HOST:-the current docker context}" >&2
  local bin
  bin="$(LITEK8S_BUILD_VOLUME="${LITEK8S_BUILD_VOLUME:-litek8s-guest-build}" "$ROOT/dev/vm/build-guest-binary.sh")"
  python3 "$ROOT/dev/vm/build-guest.py" --litek8s "$bin" --out "$out.new" --cache "$ROOT/target/guest-apk-cache" >&2
  rm -rf "$out.new/build" "$out.old"
  [[ -d "$out" ]] && mv "$out" "$out.old"
  mv "$out.new" "$out"
  rm -rf "$out.old"
  echo "dev/lk: guest in $out (a running VM keeps the old one until: dev/lk dev down && dev/lk dev up)" >&2
}

# ---- the pinned litek8s (dev/stable.sh) ---------------------------------

STABLE="${LITEK8S_STABLE:-$HOME/.litek8s/stable}"

stable() {
  # Its own home inside $LITEK8S_STABLE, next to bin/, vm/ and REVISION.
  # The variables for single paths are set as well, for pinned builds from
  # before LITEK8S_HOME.
  export LITEK8S_CONTEXT_PREFIX="${LITEK8S_CONTEXT_PREFIX:-lkstable-}"
  profile "$STABLE" "$STABLE/bin/litek8s"
  export LITEK8S_DEV_HOME="$STABLE/data/dev" LITEK8S_DOCKER_SOCKET="$SOCK" LITEK8S_CONFIG="$STABLE/config.yaml" KUBECONFIG="$KCFG"
  export LITEK8S_DEV_VM_ASSETS="$STABLE/vm"
}

stable_install() {
  local rev src new
  rev="$(git -C "$ROOT" rev-parse --verify "${1:-HEAD}^{commit}")"
  # The guest build bind-mounts the sources: they must be under $HOME, which
  # the dev VM shares.
  src="$STABLE.src"
  new="$STABLE.new"
  rm -rf "$src" "$new"
  mkdir -p "$src" "$new/bin"
  git -C "$ROOT" archive "$rev" | tar -x -C "$src"
  echo "building litek8s ${rev:0:12} for macOS" >&2
  (cd "$src" && LITEK8S_GIT_COMMIT="${rev:0:12}" CARGO_TARGET_DIR="$ROOT/target/stable-host" cargo build --release --locked)
  cp "$ROOT/target/stable-host/release/litek8s" "$new/bin/litek8s"
  if [[ -S "$SOCK" ]] && DOCKER_HOST="unix://$SOCK" docker version >/dev/null 2>&1; then
    export DOCKER_HOST="unix://$SOCK"
  fi
  echo "building the dev VM's guest on ${DOCKER_HOST:-the current docker context}" >&2
  LITEK8S_GIT_COMMIT="${rev:0:12}" LITEK8S_BUILD_VOLUME=litek8s-guest-build "$src/dev/vm/build-guest-binary.sh" >/dev/null
  python3 "$src/dev/vm/build-guest.py" --litek8s "$src/target/guest-musl-arm64/release/litek8s" --out "$new/vm" --cache "$ROOT/target/guest-apk-cache" >&2
  rm -rf "$new/vm/build"
  echo "$rev" >"$new/REVISION"
  # Swap the installation only: the cluster's data next to it stays (a
  # running VM runs its own copy of the binary).
  mkdir -p "$STABLE"
  for f in bin vm REVISION; do
    rm -rf "$STABLE/$f.old"
    [[ -e "$STABLE/$f" ]] && mv "$STABLE/$f" "$STABLE/$f.old"
    mv "$new/$f" "$STABLE/$f"
    rm -rf "$STABLE/$f.old"
  done
  rm -rf "$new" "$src"
  echo "installed $rev in $STABLE (a running cluster keeps the old one until: dev/stable.sh down && dev/stable.sh up)" >&2
}

stable_cmd() {
  stable
  case "${1:-}" in
    install) shift; stable_install "$@" ;;
    up) shift; exec "$BIN" dev up "$@" ;;
    down | status | reset) exec "$BIN" dev "$1" ;;
    env) lk_env ;;
    *) usage ;;
  esac
}

case "${1:-}" in
  "" | -h | --help) usage ;;
  stable) shift; stable_cmd "$@" ;;
  env) checkout; lk_env ;;
  build-vm) checkout; build_vm ;;
  paths)
    checkout
    echo "LITEK8S_HOME  $HOME_DIR"
    echo "binary        $BIN"
    echo "docker.sock   $SOCK"
    echo "kubeconfig    $KCFG"
    echo "dev data      $HOME_DIR/data/dev"
    echo "VM guest      ${LITEK8S_DEV_VM_ASSETS:-$HOME_DIR/data/vm}"
    ;;
  *)
    checkout
    ensure_built
    if [[ "${1:-}" == dev && "${2:-}" == up && -z "${LITEK8S_DEV_VM_ASSETS:-}" && "$(uname)" == Darwin && ! -f "$HOME_DIR/data/vm/Image" ]]; then
      echo "dev/lk: no VM guest built from this checkout in $HOME_DIR/data/vm: dev/lk build-vm (the first one on a machine: see dev/lk --help)" >&2
      exit 1
    fi
    exec "$BIN" "$@"
    ;;
esac
